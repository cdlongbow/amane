{
  "name": "amane-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "oxlint . && oxfmt --check . && tsc -b --noEmit && pnpm i18n:ci",
    "fix": "oxfmt . && oxlint --fix .",
    "test": "echo 'No web tests configured yet'",
    "gen-client": "openapi-ts",
    "i18n:extract": "i18next-cli extract",
    "i18n:status": "i18next-cli status",
    "i18n:ci": "i18next-cli extract --ci",
    "deps": "ncu -i",
    "deps:update": "ncu -u --target minor && pnpm install"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.14",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "liqe": "^3.8.7",
    "liquidjs": "^10.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tanstack/router-cli": "^1.167.32",
    "@tanstack/router-vite-plugin": "^1.167.34",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "i18next-cli": "^1.71.0",
    "npm-check-updates": "^23.0.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
